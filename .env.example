# Needed for `npm run dev`
GROQ_API_KEY=
TAVILY_API_KEY=

# Needed only for `npm run eval` (a judge from a different model family than the agent)
GEMINI_API_KEY=

# The agent. Groq's gpt-oss-120b is the default: fast, and reliable at tool calls.
# AGENT_PROVIDER can be "groq" or "gemini" (then GEMINI_API_KEY is needed for the agent too).
AGENT_PROVIDER=groq
AGENT_MODEL=openai/gpt-oss-120b
AGENT_EFFORT=medium

# Backup: if the agent's daily quota runs out and GEMINI_API_KEY is set, the turn continues on this model.
FALLBACK_MODEL=gemini-3.6-flash

# The eval judge model (a Gemini model while the agent is on Groq)
JUDGE_MODEL=gemini-3.6-flash

# Optional
# PORT=3000
# CONTEXT_TOKENS=12000

# Clock override, so "last Tuesday" can be tested without waiting a week.
# Leave unset in normal use. `npm run dev:demo` sets its own.
# NOW=2026-11-13T10:00:00
# TZ=Asia/Kolkata
